          "discovery",
          "observability",
          "pi"
        ],
        "parent_keywords": [
          "agent-observability",
          "topic-knowledge"
        ],
        "importance": "medium",
        "ai": {
          "provider": "",
          "model_id": "",
          "agent": ""
        },
        "confirmed_at": "2026-07-17T00:00:00Z",
        "type": "executable",
        "trigger": {
          "runtime": "node",
          "entry": "gsc-bash-observability-advisory-v1/trigger.mjs",
          "timeoutMs": 3000
        },
        "instruction": {
          "mode": "inline",
          "text": "Use gsc bash with the session alias for supported discovery commands and wrap every pipeline segment separately."
        },
        "frequency": {
          "mode": "once-per-context"
        },
        "priority": 60,
        "enabled": true
      }
    }
